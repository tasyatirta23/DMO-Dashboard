datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  role     String
}

model Incident {
  id                Int       @id @default(autoincrement())
  ticketNumber      String    @unique
  productName       String?
  productCategory   String?
  symptom           String?
  unitPelapor       String?
  priority          String?
  createdDate       DateTime?
  responseDate      DateTime?
  resolvedDate      DateTime?
  status            String?
  solver            String?
  picSolver         String?
  escalateStatus    String?
  reopenStatus      String?
  targetSlaHours    Float?
  slaStatus         String?
  alasanMissed      String?
  assigneeGroup     String?
  slaStatusModel    String?
  alasanMissedModel String?
}